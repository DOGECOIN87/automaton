# Automaton (Solana-only) — environment template
# Copy to .env and fill in. NEVER commit a filled-in .env.

# ─── Solana ────────────────────────────────────────────────────
# RPC endpoint for all on-chain reads/writes (balance, USDC-SPL, memo attestation).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Commitment for reads and transaction confirmation: processed | confirmed | finalized
SOLANA_COMMITMENT=confirmed

# ─── Inference (the agent's brain) ─────────────────────────────
# Provide at least one. The setup wizard can also configure these.
OPENAI_API_KEY=
# Optional fallbacks supported by the inference router:
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Conway (credits + inference accounting) ───────────────────
CONWAY_API_KEY=
# CONWAY_API_URL=https://api.conway.tech

# ─── GUI dashboard ─────────────────────────────────────────────
# Port the dashboard listens on (docker-compose maps this to the host).
GUI_PORT=8787

# ─── Runtime ───────────────────────────────────────────────────
# Directory for SQLite DB + wallet.json. In Docker this is the /data volume.
# On bare metal it defaults to ~/.automaton.
# AUTOMATON_DATA_DIR=
# Node environment
NODE_ENV=production
